{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "pilotfish": {
      "description": "Opt-in multi-model orchestrator. Plans and reviews in the primary session, delegates execution by role, and independently verifies non-trivial work.",
      "mode": "primary",
      "prompt": "{file:./pilotfish/prompts/pilotfish.md}",
      "steps": 300,
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "scout": "allow",
          "Explore": "allow",
          "plan-verifier": "allow",
          "security-reviewer": "allow",
          "mech-executor": "allow",
          "executor": "allow",
          "verifier": "allow",
          "security-executor": "allow"
        }
      }
    },
    "scout": {
      "description": "Narrow read-only reconnaissance for locating files, symbols, usages, configuration values, and direct answers with file references.",
      "mode": "subagent",
      "prompt": "{file:./pilotfish/prompts/scout.md}",
      "steps": 15,
      "permission": {
        "*": "deny",
        "doom_loop": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "Explore": {
      "description": "Broad read-only codebase or accessible project-local artifact reconnaissance; returns concise locations, exact references, and uncertainties.",
      "mode": "subagent",
      "prompt": "{file:./pilotfish/prompts/Explore.md}",
      "steps": 30,
      "permission": {
        "*": "deny",
        "doom_loop": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "plan-verifier": {
      "description": "Read-only fresh-context challenge of a material Plan before approval; returns READY or REVISE without planning, editing, or executing commands.",
      "mode": "subagent",
      "prompt": "{file:./pilotfish/prompts/plan-verifier.md}",
      "steps": 30,
      "permission": {
        "*": "deny",
        "doom_loop": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "security-reviewer": {
      "description": "Read-only pre-approval security analysis of trust boundaries, controls, vulnerabilities, and remediation evidence.",
      "mode": "subagent",
      "prompt": "{file:./pilotfish/prompts/security-reviewer.md}",
      "steps": 40,
      "permission": {
        "*": "deny",
        "doom_loop": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow"
      }
    },
    "mech-executor": {
      "description": "Executes fully specified mechanical work such as pattern refactors, conventional tests, documentation, bulk edits, and focused test runs.",
      "mode": "subagent",
      "prompt": "{file:./pilotfish/prompts/mech-executor.md}",
      "steps": 50,
      "permission": {
        "*": "deny",
        "doom_loop": "deny",
        "task": "deny",
        "bash": "allow",
        "edit": "allow",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": "allow"
      }
    },
    "executor": {
      "description": "Implements features, bug fixes, integrations, and design-sensitive refactors that require local engineering judgment.",
      "mode": "subagent",
      "prompt": "{file:./pilotfish/prompts/executor.md}",
      "steps": 120,
      "permission": {
        "*": "deny",
        "doom_loop": "deny",
        "task": "deny",
        "bash": "allow",
        "edit": "allow",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": "allow",
        "webfetch": "allow"
      }
    },
    "verifier": {
      "description": "Fresh-context adversarial outcome verification after implementation; reproduces evidence and returns CONFIRMED or REFUTED without planning, editing, or fixing.",
      "mode": "subagent",
      "prompt": "{file:./pilotfish/prompts/verifier.md}",
      "steps": 60,
      "permission": {
        "*": "deny",
        "doom_loop": "deny",
        "edit": "deny",
        "task": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": "allow",
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny",
          "git restore*": "deny",
          "git switch*": "deny",
          "git clean*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git cherry-pick*": "deny",
          "git stash*": "deny",
          "rm *": "deny"
        }
      }
    },
    "security-executor": {
      "description": "Handles approved security-sensitive implementation involving authentication, authorization, secrets, crypto, validation, hardening, or vulnerabilities.",
      "mode": "subagent",
      "prompt": "{file:./pilotfish/prompts/security-executor.md}",
      "steps": 250,
      "permission": {
        "*": "deny",
        "doom_loop": "deny",
        "task": "deny",
        "bash": "allow",
        "edit": "allow",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": "allow",
        "webfetch": "allow"
      }
    }
  }
}
